# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/fileprocessing
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=csv_processing

# Temporal Configuration
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=csv-processing-queue

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_FILE_SIZE=104857600
UPLOAD_DIR=/tmp/uploads
LOG_LEVEL=INFO

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fileprocessing.com

# Security
API_KEY=your-secret-api-key-change-this-in-production
RATE_LIMIT=100

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000